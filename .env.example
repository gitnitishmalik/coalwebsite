# Copy to .env.local for local development. Never commit real values.

# --- Admin login (required in production) ---
ADMIN_PASSWORD=change-me
# Long random string, e.g. `openssl rand -base64 32`
ADMIN_SESSION_SECRET=

# --- Claude AI (image reading, market brief, HBA web search) ---
ANTHROPIC_API_KEY=

# --- Storage on Vercel: add "Upstash Redis" from Vercel → Storage; these are set for you ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# --- Board images on Vercel: add "Blob" from Vercel → Storage; this is set for you ---
# BLOB_READ_WRITE_TOKEN=

# --- Daily HBA search (vercel.json cron). Any long random string. ---
CRON_SECRET=

# --- Optional ---
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# JCE_STORAGE=file   # force JSON files in ./.data (e.g. on a Hostinger Node.js host)
