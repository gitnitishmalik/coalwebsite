# Copy to .env.local for local development. Never commit real values.

# --- Admin sign-in (email + password, no defaults) ---
ADMIN_EMAIL=admin@jakarta.com             # several allowed: a@gmail.com,b@gmail.com
ADMIN_PASSWORD=                           # choose your own
ADMIN_SESSION_SECRET=                     # long random string, e.g. `openssl rand -base64 32`

# --- NVIDIA AI (build.nvidia.com → API key, starts with nvapi-) ---
NVIDIA_API_KEY=
# Optional model overrides (defaults shown — checked against NVIDIA's model list, Nov 2026)
# NVIDIA_MODEL_REASONING=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_MODEL_VISION=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Storage on Vercel: add "Upstash Redis" from Vercel → Storage; these are set for you ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Uploaded files on Vercel: add "Blob" from Vercel → Storage; this is set for you ---
# BLOB_READ_WRITE_TOKEN=

# --- Daily HBA news monitor (vercel.json cron). Any long random string. ---
CRON_SECRET=

# --- Optional ---
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# JCE_STORAGE=file   # force JSON files in ./.data (e.g. on a Hostinger Node.js host)
